# PCNav membership — release setting (WNM-11D release candidate).
# Production builds (`vite build`, locally and on Vercel) publish the INACTIVE public scaffolding:
# the Account section marked Coming Soon, with no identity provider and no member data.
# Shell variables take precedence. VITE_PCNAV_MEMBERSHIP=off builds the plain site.
# Browser-safe values only: everything here is shipped to every visitor.
VITE_PCNAV_MEMBERSHIP=public
